{
  "schema_version": "1.0.0",
  "random_seed": 42,
  "split": {"train": 0.70, "validation": 0.15, "test": 0.15},
  "tfidf": {
    "analyzer": "char",
    "ngram_range": [2, 5],
    "min_df": 2,
    "max_df": 0.995,
    "max_features": 120000,
    "sublinear_tf": true
  },
  "low_confidence_threshold": 0.55,
  "high_severity_threshold": 0.65,
  "high_risk_terms": ["起火", "冒烟", "爆炸", "鼓包", "漏电", "烫伤", "自燃", "人身伤害"],
  "topic_ids": {
    "电池与充电": 1,
    "屏幕与触控": 2,
    "发热与性能": 3,
    "信号与通信": 4,
    "影像与音频": 5,
    "外观与结构": 6,
    "系统与软件": 7,
    "正品与激活": 8,
    "配件与兼容": 9,
    "无产品问题": 10,
    "其他产品问题": 11
  }
}
